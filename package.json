{
  "name": "dunesub-integration",
  "version": "1.0.0",
  "private": true,
  "description": "Ecosystem policy tooling and a self-contained Cloudflare SEO agent service",
  "type": "module",
  "engines": { "node": ">=22.8" },
  "bin": {
    "dune-sync": "src/dune-sync.mjs",
    "security-scan": "src/security-scan.mjs"
  },
  "scripts": {
    "validate:payload": "node src/validate-payload.mjs",
    "security:scan": "node src/security-scan.mjs --policy dune-sub-baseline",
    "sync": "node src/dune-sync.mjs",
    "seo:install": "npm ci --prefix services/seo-agent",
    "seo:configure": "node scripts/seo-agent.mjs configure",
    "seo:provenance": "node scripts/verify-seo-agent-source.mjs",
    "seo:check": "npm run seo:configure && npm run check --prefix services/seo-agent",
    "seo:test": "npm test --prefix services/seo-agent",
    "seo:build": "npm run seo:configure && npm run build --prefix services/seo-agent",
    "seo:smoke": "npm run seo:build && node scripts/test-seo-agent-runtime.mjs",
    "seo:verify": "npm run seo:provenance && npm run seo:check && npm run seo:test && npm run seo:smoke",
    "seo:dev": "npm run seo:configure && npm run dev --prefix services/seo-agent",
    "seo:deploy": "node --use-env-proxy scripts/seo-agent.mjs deploy",
    "seo:status": "node --use-env-proxy scripts/seo-agent.mjs status",
    "seo:injector:configure": "node scripts/seo-injector.mjs configure",
    "seo:injector:build": "node --use-env-proxy scripts/seo-injector.mjs build",
    "seo:injector:smoke": "node scripts/test-seo-injector-runtime.mjs",
    "seo:injector:status": "node --use-env-proxy scripts/seo-injector.mjs status",
    "seo:injector:deploy": "node --use-env-proxy scripts/seo-injector.mjs deploy",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run test && npm run validate:payload && npm run security:scan"
  }
}

    "tsconfig.json": "Include permanent environment secret binding declarations for type checks without local secret values.",
    "src/crawl.ts": "Normalize sitemap entries and child sitemap URLs from explicitly configured verified HTTPS origin aliases to the canonical origin; require exact safe origins and do not follow sitemap redirects.",
